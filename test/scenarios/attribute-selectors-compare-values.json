    { "op": "querySelectorAll", "node": 0, "selectors": "[rel~=nofollow]" },
    { "op": "querySelectorAll", "node": 0, "selectors": "[lang|=en]" },
    { "op": "querySelectorAll", "node": 0, "selectors": "[href^='/Foo']" },
    { "op": "querySelectorAll", "node": 0, "selectors": "[href^='/foo']" },
    { "op": "querySelectorAll", "node": 0, "selectors": "[href^='/foo' i]" },
    { "op": "querySelectorAll", "node": 0, "selectors": "[href$='.html']" },
    { "op": "querySelectorAll", "node": 0, "selectors": "[href*='oo/ba']" },
