        { "namespace": null, "prefix": null, "localName": "rel", "value": "next nofollow" },
        { "namespace": null, "prefix": null, "localName": "lang", "value": "en-US" }
      ] },
    { "id": 3, "kind": "element", "parent": 1, "localName": "a",
      "attributes": [{ "namespace": null, "prefix": null, "localName": "href", "value": "" }] }
