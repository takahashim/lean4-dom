{
  "_basis": {
    "kind": "spec",
    "spec": "https://drafts.csswg.org/css-syntax-3/#anb-microsyntax",
    "algorithm": ["<a-n-plus-b>"],
    "steps": "index i = An + B for any non-negative integer n",
    "note": "n が非負に限るので、A が負なら表す index は有限個になる。:nth-child(-n+2) は先頭の二つを指す。Dom/Spec/Selector.lean の anbMatches_iff がこれを定理にしてある。"
  },
  "nodes": [
    { "id": 0, "kind": "document" },
    { "id": 1, "kind": "element", "parent": 0, "localName": "ul" },
    { "id": 2, "kind": "element", "parent": 1, "localName": "li" },
    { "id": 3, "kind": "element", "parent": 1, "localName": "li" },
    { "id": 4, "kind": "element", "parent": 1, "localName": "li" },
    { "id": 5, "kind": "element", "parent": 1, "localName": "li" },
    { "id": 6, "kind": "element", "parent": 1, "localName": "li" }
  ],
  "ranges": [], "iterators": [], "walkers": [], "listeners": [], "observers": [],
  "operations": [
    { "op": "querySelectorAll", "node": 0, "selectors": "li:nth-child(-n+2)" },
    { "op": "querySelectorAll", "node": 0, "selectors": "li:nth-last-child(-n+2)" },
    { "op": "querySelectorAll", "node": 0, "selectors": "li:nth-child(-2n+4)" },
    { "op": "querySelectorAll", "node": 0, "selectors": "li:nth-child(-n+0)" },
    { "op": "querySelectorAll", "node": 0, "selectors": "li:nth-child(3n-1)" },
    { "op": "querySelectorAll", "node": 0, "selectors": "li:nth-of-type(-n+1)" },
    { "op": "querySelectorAll", "node": 0, "selectors": "li:nth-child(even)" },
    { "op": "querySelectorAll", "node": 0, "selectors": "li:nth-child(-n-1)" }
  ]
}
