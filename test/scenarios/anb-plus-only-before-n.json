{
  "_basis": {
    "kind": "spec",
    "spec": "https://drafts.csswg.org/css-syntax-3/#the-anb-type",
    "algorithm": [
      "<a-n-plus-b>"
    ],
    "steps": "'+'? が付くのは n・n-・<ndashdigit-ident> で始まる形だけで、-n・-n-・<dashndashdigit-ident> と odd・even の前には '+' を置けない",
    "note": "`-n+3` と `+n+3` と `+n-1` は当たる。最後の `+-n+3` は delim `+`、ident `-n`、number `+3` で、`'+'? n <signed-integer>` にも `-n <signed-integer>` にも当たらないので SyntaxError。"
  },
