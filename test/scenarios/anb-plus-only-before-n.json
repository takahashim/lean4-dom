      "node": 0,
      "selectors": ":nth-child(+n+3)"
    },
    {
      "op": "querySelectorAll",
      "node": 0,
      "selectors": ":nth-child(+n-1)"
    },
    {
      "op": "querySelectorAll",
      "node": 0,
      "selectors": ":nth-child(+-n+3)"
    }
  ]
