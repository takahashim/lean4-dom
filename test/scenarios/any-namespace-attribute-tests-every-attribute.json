      "localName": "p",
      "attributes": [
        {
          "namespace": null,
          "prefix": null,
          "localName": "a",
          "value": "1"
        },
        {
          "namespace": "http://example.com/ns",
          "prefix": "x",
          "localName": "a",
          "value": "2"
        }
      ]
    },
    {
      "id": 3,
      "kind": "element",
      "parent": 1,
      "localName": "p",
      "attributes": [
        {
          "namespace": "http://example.com/ns",
          "prefix": "x",
          "localName": "a",
          "value": "1"
        },
        {
          "namespace": null,
          "prefix": null,
          "localName": "a",
          "value": "2"
        }
      ]
    }
  ],
