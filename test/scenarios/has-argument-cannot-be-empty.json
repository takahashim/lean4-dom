    { "id": 2, "kind": "element", "parent": 1, "localName": "div" },
    { "id": 3, "kind": "element", "parent": 2, "localName": "p" }
  ],
  "ranges": [], "iterators": [], "walkers": [], "listeners": [], "observers": [],
  "operations": [
    { "op": "querySelectorAll", "node": 0, "selectors": "div:has(p)" },
    { "op": "querySelectorAll", "node": 0, "selectors": "div:has(> p)" },
    { "op": "querySelectorAll", "node": 0, "selectors": "div:has(p, span)" },
    { "op": "querySelectorAll", "node": 0, "selectors": "div:has()" }
  ]
