        "attr": 1
      }
    },
    {
      "op": "attrQuery",
      "attr": 1,
      "query": "ownerDocument"
    },
    {
      "op": "attrQuery",
      "attr": 1,
      "query": "ownerElement"
    },
    {
      "op": "getAttribute",
      "element": 2,
      "name": "a"
    }
  ]
