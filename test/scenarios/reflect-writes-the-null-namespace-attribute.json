      "parent": 0,
      "attributes": [
        {
          "namespace": "http://example.com/ns",
          "localName": "id",
          "value": "ns"
        }
      ]
    },
    {
      "id": 2,
      "kind": "element",
      "parent": 1,
      "attributes": [
        {
          "namespace": "http://example.com/ns",
          "localName": "class",
          "value": "ns"
        },
        {
          "namespace": "http://example.com/ns",
          "localName": "slot",
          "value": "ns"
        }
      ]
    }
  ],
  "ranges": [],
  "iterators": [],
  "walkers": [],
  "observers": [],
  "operations": [
    {
      "op": "setReflected",
      "element": 1,
      "property": "id",
      "value": "w"
    },
    {
      "op": "setReflected",
      "element": 2,
      "property": "className",
      "value": "w"
    },
    {
      "op": "setReflected",
      "element": 2,
      "property": "slot",
